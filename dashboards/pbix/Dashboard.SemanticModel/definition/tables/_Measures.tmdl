			    [Average Farmland per Household (ha)] > 0 && [Average Farmland per Household (ha)] < 0.5,
			    "BÁO ĐỘNG ĐỎ: THIẾU ĐẤT CANH TÁC (< 0.5 ha/hộ)",
			    "Bình thường"
			)
		displayFolder: 06_Productive_Assets_Land_Credit
		lineageTag: 65253ae5-c7ae-4f8d-8af5-5f7d885a9aea

