table _Measures
	lineageTag: 6930d131-3a6c-4289-8845-0dd1bee87397

	measure 'Selected Period Order' =
			
			VAR ExplicitOrder = SELECTEDVALUE(dim_ky_baocao[thu_tu_ky])
			VAR LatestOrder = 
			    CALCULATE(
			        MAX(dim_ky_baocao[thu_tu_ky]),
			        REMOVEFILTERS(dim_ky_baocao),
			        dim_ky_baocao[is_latest] = TRUE()
			    )
			VAR FallbackMax = 
			    CALCULATE(
			        MAX(dim_ky_baocao[thu_tu_ky]),
			        REMOVEFILTERS(dim_ky_baocao)
			    )
			RETURN
			    COALESCE(ExplicitOrder, LatestOrder, FallbackMax, 3)
		formatString: 0
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: cfa71ae6-d552-518c-b931-c0acf8532b53

	measure 'Previous Period Order' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    IF(CurOrder > 1, CurOrder - 1, BLANK())
		formatString: 0
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: f5fad3cc-60d4-5f9e-bd50-33fd160fd91c

	measure 'Selected Period Code' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    CALCULATE(
			        MAX(dim_ky_baocao[ma_ky]),
			        REMOVEFILTERS(dim_ky_baocao),
			        dim_ky_baocao[thu_tu_ky] = CurOrder
			    )
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: c0b44ec2-9fac-50e9-aa06-2f5b4d1debb0

	measure 'Selected Period Name' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    CALCULATE(
			        MAX(dim_ky_baocao[ten_ky]),
			        REMOVEFILTERS(dim_ky_baocao),
			        dim_ky_baocao[thu_tu_ky] = CurOrder
			    )
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: 10f27d4e-43d4-5125-b135-2369793a6b7b

	measure 'Previous Period Name' =
			
			VAR PrevOrder = [Previous Period Order]
			RETURN
			    IF(
			        ISBLANK(PrevOrder),
			        "Kỳ gốc (Baseline 2019)",
			        CALCULATE(
			            MAX(dim_ky_baocao[ten_ky]),
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = PrevOrder
			        )
			    )
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: 7e85bd96-e5b8-5bbb-8e2e-c73b719a7c54

	measure 'Selected Policy Stage' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    CALCULATE(
			        MAX(dim_ky_baocao[giai_doan_chinh_sach]),
			        REMOVEFILTERS(dim_ky_baocao),
			        dim_ky_baocao[thu_tu_ky] = CurOrder
			    )
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: c5ef3e05-604c-5295-b2f8-13b3af5ea74e

	measure 'Selected Period Year' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    CALCULATE(
			        MAX(dim_ky_baocao[nam_moc]),
			        REMOVEFILTERS(dim_ky_baocao),
			        dim_ky_baocao[thu_tu_ky] = CurOrder
			    )
		formatString: 0
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: fc45210f-aba4-5c1d-b570-047b7e090109

	measure 'Active Period Header Title' =
			
			"📌 KỲ DỮ LIỆU ĐANG XEM: " & UPPER([Selected Period Name]) & 
			" | GIAI ĐOẠN CHÍNH SÁCH: " & [Selected Policy Stage] & 
			" (So sánh với: " & [Previous Period Name] & ")"
		displayFolder: 00_Time_Intelligence_Context
		lineageTag: 2902c5cc-61af-5e37-a6b5-a3d420d81e10

