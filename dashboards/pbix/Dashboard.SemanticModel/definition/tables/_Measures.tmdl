		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Prev DTTS Households' =
			
			VAR PrevOrder = [Previous Period Order]
			RETURN
			    IF(
			        ISBLANK(PrevOrder),
			        BLANK(),
			        CALCULATE(
			            SUM(fact_nhao_dantoc[tong_so_ho_co_nha]),
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = PrevOrder
			        )
			    )
		formatString: "#,##0 ""hộ"""
		displayFolder: 09_Multi_Period_Variance_Targets
