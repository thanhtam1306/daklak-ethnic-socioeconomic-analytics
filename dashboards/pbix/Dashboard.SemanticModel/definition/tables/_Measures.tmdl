	measure 'Temporary House Rate %' =
			
			DIVIDE([Temporary House Count], [Total DTTS Households], 0)
		formatString: 0.0%
		displayFolder: 05_Living_Conditions_Sanitation
		lineageTag: 4c584217-2c61-4971-bc07-bf4a58898508

	measure 'Permanent House Rate %' =
			
