		annotation PBI_FormatHint = {"isCustom":true}

	measure 'DTTS Households Variance' =
			
			VAR PrevVal = [Prev DTTS Households]
			RETURN
			    IF(ISBLANK(PrevVal), BLANK(), [Total DTTS Households] - PrevVal)
		formatString: +#,##0;-#,##0;0
		displayFolder: 09_Multi_Period_Variance_Targets
		lineageTag: fe40f1e5-6f63-553f-b52a-0d4323752ab8

	measure 'Prev Untrained Labor Rate %' =
			
			VAR PrevOrder = [Previous Period Order]
			VAR PrevUntrained = CALCULATE(SUM(fact_trinhdo_cmkt_dantoc[khong_co_cmkt]), REMOVEFILTERS(dim_ky_baocao), dim_ky_baocao[thu_tu_ky] = PrevOrder)
			VAR PrevTotal     = CALCULATE(SUM(fact_trinhdo_cmkt_dantoc[tong_lao_dong]), REMOVEFILTERS(dim_ky_baocao), dim_ky_baocao[thu_tu_ky] = PrevOrder)
			RETURN
			    IF(ISBLANK(PrevOrder), BLANK(), DIVIDE(PrevUntrained, PrevTotal, 0))
		formatString: 0.0%
		displayFolder: 09_Multi_Period_Variance_Targets
		lineageTag: ace77846-2d45-5b10-8c71-2e0a398f6b73

	measure 'Untrained Labor Rate Variance (pp)' =
			
			VAR PrevVal = [Prev Untrained Labor Rate %]
			RETURN
			    IF(ISBLANK(PrevVal), BLANK(), [Untrained Labor Rate %] - PrevVal)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 09_Multi_Period_Variance_Targets
		lineageTag: d5546ef7-b548-5b3e-8bb2-f97f223cb49e

	measure 'Stage Target Untrained Rate %' =
			
			VAR CurStage = [Selected Policy Stage]
			RETURN
			    DIVIDE(
			        CALCULATE(
			            MAX(dim_chitieu_kehoach_ngansach[chi_tieu_muc_tieu]),
			            REMOVEFILTERS(dim_chitieu_kehoach_ngansach),
			            dim_chitieu_kehoach_ngansach[giai_doan_chinh_sach] = CurStage,
			            dim_chitieu_kehoach_ngansach[ma_chitieu] = "TY_LE_CHUA_DAO_TAO_CMKT"
			        ),
			        100,
			        0.75
			    )
		formatString: 0.0%
		displayFolder: 09_Multi_Period_Variance_Targets
		lineageTag: e1f556d8-2375-5b71-8178-60acdf9c8f67

	measure 'Prev Temporary House Count' =
			
