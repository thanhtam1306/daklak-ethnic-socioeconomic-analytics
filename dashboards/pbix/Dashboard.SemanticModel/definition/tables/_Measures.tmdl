		formatString: 0.0%
		displayFolder: 05_Living_Conditions_Sanitation
		lineageTag: 7911bd7f-7035-49e6-9483-3885504130f1

	measure 'Hygienic Latrine Rate %' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    IF(
			        ISFILTERED(dim_diaban[ten_huyen]) || ISFILTERED(dim_diaban[ma_huyen]),
			        CALCULATE(
			            AVERAGE(fact_dantocthiet_yeu_huyen[ty_le_ho_xi_hop_ve_sinh_pct]) / 100,
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = CurOrder,
			            TREATAS(VALUES(dim_diaban[ma_huyen]), fact_dantocthiet_yeu_huyen[ma_huyen])
			        ),
			        CALCULATE(
			            AVERAGE(fact_dantocthiet_yeu_huyen[ty_le_ho_xi_hop_ve_sinh_pct]) / 100,
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = CurOrder
			        )
			    )
		formatString: 0.0%
		displayFolder: 05_Living_Conditions_Sanitation
		lineageTag: 286660e4-f86b-4966-b325-c749b902b778

	measure 'Clean Water Rate %' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    IF(
			        ISFILTERED(dim_diaban[ten_huyen]) || ISFILTERED(dim_diaban[ma_huyen]),
			        CALCULATE(
			            AVERAGE(fact_dantocthiet_yeu_huyen[ty_le_nuoc_hop_ve_sinh_pct]) / 100,
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = CurOrder,
			            TREATAS(VALUES(dim_diaban[ma_huyen]), fact_dantocthiet_yeu_huyen[ma_huyen])
			        ),
			        CALCULATE(
			            AVERAGE(fact_dantocthiet_yeu_huyen[ty_le_nuoc_hop_ve_sinh_pct]) / 100,
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = CurOrder
			        )
			    )
		formatString: 0.0%
		displayFolder: 05_Living_Conditions_Sanitation
		lineageTag: 9c370785-dac7-408b-96e5-e3ce68793da1

	measure 'Internet Access Households' =
			
			VAR CurOrder = [Selected Period Order]
			RETURN
			    IF(
			        ISFILTERED(dim_diaban[ten_huyen]) || ISFILTERED(dim_diaban[ma_huyen]),
			        CALCULATE(
			            SUM(fact_dantocthiet_yeu_huyen[so_ho_co_internet]),
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = CurOrder,
			            TREATAS(VALUES(dim_diaban[ma_huyen]), fact_dantocthiet_yeu_huyen[ma_huyen])
			        ),
			        CALCULATE(
			            SUM(fact_dantocthiet_yeu_huyen[so_ho_co_internet]),
			            REMOVEFILTERS(dim_ky_baocao),
			            dim_ky_baocao[thu_tu_ky] = CurOrder
